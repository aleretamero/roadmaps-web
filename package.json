{
  "name": "roadmaps-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && openapi-typescript contracts/openapi.yaml -o src/lib/api/schema.d.ts --silent && tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix . ; prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "check": "pnpm format:check && pnpm lint && pnpm lint:colors && pnpm typecheck && pnpm test",
    "lint:colors": "node scripts/check-no-hex.mjs",
    "routes": "tsr generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --project storybook",
    "prototype": "node scripts/serve-prototype.mjs",
    "prototype:capture": "node scripts/capture-prototype.mjs",
    "api:types": "openapi-typescript contracts/openapi.yaml -o src/lib/api/schema.d.ts",
    "api:lint": "redocly lint contracts/openapi.yaml --skip-rule=operation-4xx-problem-details-rfc7807 --skip-rule=info-license --skip-rule=operation-2xx-response",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:compare": "node scripts/compare-with-prototype.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lowlight": "3.3.0",
    "lucide-react": "^1.70.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "^2.76.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.6",
    "jsdom": "^31.0.0",
    "msw": "3.0.4",
    "msw-storybook-addon": "3.0.3",
    "openapi-msw": "2.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.63.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
